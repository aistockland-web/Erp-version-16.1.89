{
  "name": "Stockland Ethiopia ERP — Free Codespaces profile (4 core / 16 GB RAM)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/stockland-erp",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "initializeCommand": "bash .devcontainer/initialize-host.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "enableNonRootDocker": true
    }
  },
  "forwardPorts": [
    8080,
    8081,
    8082
  ],
  "portsAttributes": {
    "8080": {
      "label": "Stockland ERP 16.2.13 operational baseline — private QA",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8081": {
      "label": "Stockland ERP 16.2.13 → 16.2.15 upgrade test — private QA",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8082": {
      "label": "Stockland ERP MySQL 8.0.46 compatibility — private QA",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "dbaeumer.vscode-eslint",
        "DavidAnson.vscode-markdownlint",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  }
}
