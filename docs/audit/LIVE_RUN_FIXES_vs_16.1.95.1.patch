 	/**
+	 * Fits a value to its audit column width without ever failing the audit write.
+	 *
+	 * Oversized text is shortened to the column width and ends with a SHA-256 digest marker of the
+	 * complete original text, so the tamper-evident hash chain still commits to the full content.
+	 *
+	 * @param string|null $value Normalized audit text.
+	 * @param int         $max   Maximum stored character width of the target column.
+	 * @return string|null Value that fits the column.
+	 */
+	private static function fit( $value, $max ) {
+		if ( null === $value || mb_strlen( $value, 'UTF-8' ) <= $max ) {
+			return $value;
+		}
+		$marker = '...[sha256:' . substr( hash( 'sha256', $value ), 0, 16 ) . ']';
+		$keep   = max( 0, $max - mb_strlen( $marker, 'UTF-8' ) );
+		return mb_substr( $value, 0, $keep, 'UTF-8' ) . $marker;
+	}
